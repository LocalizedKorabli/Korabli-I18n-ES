msgid "IDS_PXSB005_DESCR"
msgstr "<p>Buque de combate de corta distancia.<br/>Dificultad de manejo: alta.</p><p class=\"p_spacing\"> </p><p>Varg («El Exiliado»): un barco maldito, buque insignia de la escuadra pirata que surge de las brumas del mar del Norte y se desvanece sin dejar rastro entre los numerosos fiordos. Al igual que su capitán, es inmortal: a lo largo de muchos siglos solo se ha endurecido y vuelto más firme que el acero, lo que puede conferirle invulnerabilidad por un breve tiempo. El aura de Varg drena la energía vital de los no iniciados que se acercan imprudentemente.</p>"

msgid "IDS_PXSB005_FULL"
msgstr "Varg"

msgid "IDS_PXSB005_NUMBER"
msgstr "1"

msgid "IDS_PXSB005_YEAR"
msgstr "1939"

