msgid "IDS_ARC_EVENT_RULES_POINTS_SCENARIO_BATTLES_DESCRIPTION"
msgstr "10 puntos por cada estrella recibida cuando gana tu equipo."

msgid "IDS_ARC_EVENT_RULES_RESTRICTION"
