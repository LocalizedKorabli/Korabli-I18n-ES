msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Lucharás codo con codo con otros jugadores contra un equipo de bots. El mapa y el modo de batalla se seleccionan al azar."

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Reglas de participación"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "El tamaño máximo de los equipos depende del nivel de los barcos:"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "• Niveles I–III: 6 contra 6;"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_TEXT_3"
msgstr "• Nivel IV: 6 contra 6 o 9 contra 9;"

msgid "IDS_MODAL_WINDOW_COOPERATIVEBATTLE_RULES_PARAGRAPH_2_TEXT_4"
msgstr "• Niveles V–X y superbarcos: 9 contra 9."

