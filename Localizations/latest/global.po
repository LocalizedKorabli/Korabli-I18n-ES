msgstr "Con gusto lo escucharía algún día. Disculpe, Majestad, debemos ir a recibir a la delegación de Astrillia."

msgid "IDS_ETERIA_TEXT_EPISODE_2_SCENE_17"
msgstr "¡Hasta luego, vieja!"

