msgid "IDS_BASE_AI_18"
msgstr "¡Fase de calibración superada!"

msgid "IDS_BASE_AI_19"
msgstr "Apunta a un barco enemigo y pulsa [KEY_F3] para que los autómatas concentren el fuego en ese barco."

