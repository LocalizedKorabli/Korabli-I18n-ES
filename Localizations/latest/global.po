msgstr "DETALLES DE LA BATALLA"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "ENEMIGO"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Destruye a los bots en los barcos de la era de los acorazados. ¡El número de enemigos aumenta constantemente!"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "POTENCIADORES"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_2_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "En el lugar de algunos enemigos destruidos aparecen potenciadores. ¡Recógelos mientras estén disponibles!"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_HEADER"
msgstr "DETALLES DE LA BATALLA"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "DESTRUCCIÓN DEL BLINDAJE"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "El blindaje se destruye con el daño."

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Si un sector de blindaje se destruye por completo, un proyectil puede impactar en una parte vulnerable del barco e infligir un daño considerable."

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "CALIBRE PRINCIPAL Y MEDIO"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "El armamento principal inflige mucho daño, pero tarda mucho en recargarse."

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "El calibre medio se recarga más rápido, pero inflige menos daño."

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "REGRESO A LA BATALLA"

msgid "IDS_MODAL_WINDOW_DREADNOUGHT_BATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Los destructores destruidos regresan a la batalla si el equipo tiene al menos un acorazado o un crucero."

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_ASIDE_CONTAINER_MULTIBOOST_CARD_LINK_HINT"
msgstr "Vincular paquete de bonificaciones"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_ASIDE_CONTAINER_MULTIBOOST_CARD_PURCHASE_HINT"
msgstr "Comprar paquete de bonificaciones"

msgid "IDS_MODAL_WINDOW_ECONOMIC_BOOSTS_ASIDE_CONTAINER_MULTIBOOST_CARD_UNAVAILABLE_HINT"
