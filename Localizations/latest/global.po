msgstr "Pulsa [CMD_SWITCH_ATBA_AIRDEFENSE] para desactivar tus cañones AA. Desactivar los cañones AA ayuda a no ser detectado por los aviones enemigos durante un período de tiempo mayor."

msgid "IDS_LOADING_TOOLTIP_LEVEL10_17"
msgstr "Los destructores destacan en los ataques sorpresa."

msgid "IDS_LOADING_TOOLTIP_LEVEL10_18"
msgstr "Acuérdate de proteger a los portaaviones aliados."

