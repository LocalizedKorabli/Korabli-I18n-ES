msgid "IDS_EV19_ATTDEF_CHAT_LAST_CHANCE"
msgstr "Esta es tu última reaparición durante esta batalla."

msgid "IDS_EV19_ATTDEF_CHAT_STATION"
msgstr "No se puede dañar la estación. ¡Destruye todos los generadores!"

msgid "IDS_EV19_ATTDEF_CSM_ALL_01"
msgstr "La estación es invulnerable mientras que al menos uno de los generadores siga funcionando. La destrucción de un generador aumenta el tiempo de ataque."

msgid "IDS_EV19_ATTDEF_CSM_ALL_02"
msgstr "La pérdida de un barco aliado o un generador del equipo defensivo acelerará la regeneración de PV de otros defensores y la recarga de su batería principal y tubos lanzatorpedos."

msgid "IDS_EV19_ATTDEF_CSM_DEFENDERS_ARE_OVER_T0"
msgstr ""
"Derrota. \n"
"Todos los barcos aliados están destruidos."

msgid "IDS_EV19_ATTDEF_CSM_DEFENDERS_ARE_OVER_T1"
msgstr ""
"¡Victoria! \n"
"Todos los barcos enemigos están destruidos."

msgid "IDS_EV19_ATTDEF_CSM_SHIELD_LOST_T0"
msgstr ""
"¡Todos los generadores están destruidos!\n"
"¡Defiende la estación!"

msgid "IDS_EV19_ATTDEF_CSM_SHIELD_LOST_T1"
msgstr ""
"¡Todos los generadores están destruidos!\n"
"¡Ataca la estación!"

msgid "IDS_EV19_ATTDEF_CSM_STATION_DESTROYED_T0"
msgstr ""
"Derrota. \n"
"Estación destruida."

msgid "IDS_EV19_ATTDEF_CSM_STATION_DESTROYED_T1"
msgstr ""
"¡Victoria! \n"
"Estación destruida."

msgid "IDS_EV19_ATTDEF_CSM_TIME_IS_OVER_T0"
msgstr ""
"¡Victoria! \n"
"Ataque repelido."

msgid "IDS_EV19_ATTDEF_CSM_TIME_IS_OVER_T1"
msgstr ""
"Derrota. \n"
"El tiempo de ataque se ha acabado."

msgid "IDS_EV2020_NCB_BOSS"
msgstr ""
"¡Atención!\n"
"¡Rasputin a la vista!"

msgid "IDS_EV2020_NCB_BOSS_ALERT"
msgstr "Se ha identificado la zona de aparición del Rasputin."

msgid "IDS_EV2020_NCB_BOSS_IS_DEAD"
msgstr ""
"¡El Rasputin está derrotado!\n"
"¡Corre hacia el Portal!"

msgid "IDS_EV2020_NCB_CHEATER_LEVEL_UP"
msgstr ""
"¡Atención!\n"
"Los enemigos se están volviendo más fuertes."

msgid "IDS_EV2020_NCB_CHEATER_SPAWN"
msgstr ""
"¡Corre hacia el Portal!\n"
"Los enemigos se han vuelto más fuertes e intentarán frenarte."

msgid "IDS_EV2020_NCB_RULES_1"
msgstr "Mejora tu barco usando puntos de batalla. Puedes conseguir estos puntos destruyendo oponentes."

msgid "IDS_EV2020_NCB_RULES_PORTAL"
msgstr "No más de tres jugadores por equipo"

msgid "IDS_EV2020_NCB_RULES_PORTAL_HARD"
msgstr "Dificultad de la Incursión: moderada. No más de cuatro jugadores por equipo."

