msgid "IDS_TITLE_PCM061_SPECIAL_MOD_I_MIDWAY"
msgstr "Puntos de anclaje externos modificados"

msgid "IDS_TITLE_PCM062_SPECIAL_MOD_I_HAKURYU"
msgstr "Sistema de inyección de combustible"

msgid "IDS_TITLE_PCM063_FIGHTER_MOD_I"
msgstr "Modificación 2 de los aviones de ataque"

msgid "IDS_TITLE_PCM064_TORPEDOBOMBER_MOD_I"
msgstr "Modificación 2 de los bombarderos torpederos"

msgid "IDS_TITLE_PCM065_DIVEBOMBER_MOD_I"
msgstr "Modificación 2 de los bombarderos"

msgid "IDS_TITLE_PCM066_TORPEDOBOMBER_MOD_II"
msgstr "Modificación 1 de los bombarderos torpederos"

msgid "IDS_TITLE_PCM067_FIGHTER_MOD_II"
msgstr "Modificación 1 de los aviones de ataque"

msgid "IDS_TITLE_PCM068_PLANEENGINE_MOD_I"
msgstr "Modificación 1 de los motores de los aviones"

msgid "IDS_TITLE_PCM069_MOVEMENT_MOD_I"
msgstr "Protección de la sala de máquinas"

msgid "IDS_TITLE_PCM070_TORPEDO_MOD_IV"
msgstr "Modificación 2 de los tubos lanzatorpedos"

msgid "IDS_TITLE_PCM071_TORPEDOBOMBS_MOD_I"
