msgstr "Makarov U"

msgid "IDS_PRSC916_DESCR"
msgstr "Copia del barco «Almirante Makarov» para las Pruebas de entrenamiento y las Operaciones."

msgid "IDS_PRSC916_FULL"
msgstr "Makarov (Training)"

msgid "IDS_PRSC916_NUMBER"
