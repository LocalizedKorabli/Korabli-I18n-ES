msgid "IDS_TITLE_PCM049_SPECIAL_MOD_I_HINDENBURG"
msgstr "Equipamiento de control de daños mejorado"

msgid "IDS_TITLE_PCM050_SPECIAL_MOD_I_HENRI_IV"
msgstr "Mecanismos de carga de la batería principal mejorados"

msgid "IDS_TITLE_PCM051_SPECIAL_MOD_I_MINOTAUR"
msgstr "Sistema de cortina de humo de aerosol"

msgid "IDS_TITLE_PCM052_SPECIAL_MOD_I_DES_MOINES"
msgstr "Planta de propulsión mejorada"

msgid "IDS_TITLE_PCM053_SPECIAL_MOD_I_WORCESTER"
msgstr "Medidas de respuesta mejoradas"

msgid "IDS_TITLE_PCM054_SPECIAL_MOD_I_MOSKVA"
msgstr "Alcance eficaz de la batería principal extendido"

msgid "IDS_TITLE_PCM055_SPECIAL_MOD_I_KHABAROVSK"
msgstr "Director de control de fuego maestro"

msgid "IDS_TITLE_PCM056_SPECIAL_MOD_I_Z_52"
msgstr "Sistema de control de fuego de torpedos"

msgid "IDS_TITLE_PCM057_SPECIAL_MOD_I_SHIMAKAZE"
msgstr "Sistema de recarga rápida de los tubos lanzatorpedos"

msgid "IDS_TITLE_PCM058_SPECIAL_MOD_I_GEARING"
msgstr "Ocultación del casco mejorada"

msgid "IDS_TITLE_PCM059_SPECIAL_MOD_I_YUEYANG"
msgstr "Artillería principal mejorada"

msgid "IDS_TITLE_PCM060_SPECIAL_MOD_I_GROZOVOI"
