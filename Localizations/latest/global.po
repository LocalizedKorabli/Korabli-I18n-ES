msgstr "¡Has conseguido salir por el Portal!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_6"
msgstr "¡Eres el único superviviente!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_7"
msgstr "Tu barco ha sido destruido"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_DESCRIPTION_5"
msgstr "¡Has conseguido salir por el Portal!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_DESCRIPTION_6"
msgstr "¡Eres el campeón del Octágono!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_DESCRIPTION_7"
msgstr " "

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_DESCRIPTION_HAS_PREM"
msgstr "Cuenta premium"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_EVALUATION_TITLE_5"
msgstr "¡Lo has bordado!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_EVALUATION_TITLE_6"
msgstr "¡Lo has bordado!"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_EVALUATION_TITLE_7"
msgstr "Tu barco ha quedado destruido."

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_REWARD_TITLE"
msgstr "Tu recompensa después de la batalla:"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_KEY_BATTLE_RESULTS_TITLE"
msgstr "Tu puntuación"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_RESULTS_TITLE"
msgstr "Recompensa de la batalla"

msgid "IDS_MODAL_WINDOW_PURCHASE_AND_LINK_MULTIBOOST"
msgstr "Comprar bonificaciones"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_HEADER"
msgstr "Operaciones"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Detalles de la batalla"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Te enfrentarás a otros jugadores contra bots. Cada operación tiene sus propios elementos de historia únicos."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "La operación se selecciona al azar. La complejidad depende de los niveles y tipos de barcos de tu equipo."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Tareas"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Para ganar, tu equipo debe alcanzar el objetivo principal."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Cuantas más misiones adicionales completes durante la operación, más recursos obtendrás."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_HEADER"
msgstr "Batalla aleatoria"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Detalles de la batalla"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Lucha junto con otros jugadores en una batalla entre dos equipos."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "El mapa y el modo de batalla se seleccionan aleatoriamente."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Reglas de participación"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "El tamaño máximo de los equipos depende de los niveles de los barcos."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "• Niveles I–III: 6 contra 6;"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_3"
msgstr "• Nivel IV: 6 contra 6 o 9 contra 9;"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_4"
msgstr "• Niveles V–VI: 9 contra 9 o 12 contra 12;"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_5"
msgstr "• Niveles VII–X y superbarcos: 12 contra 12."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_HEADER"
msgstr "Batalla de clasificación"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Detalles de la batalla"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Te enfrentarás a otros jugadores, obteniendo rangos y progresando por las ligas."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "La temporada de Batallas de clasificación se divide en Esprints. Tu progreso en la liga se reinicia con cada Esprint."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Condiciones de la temporada"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Liga de Bronce"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Liga de Plata"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_3"
msgstr "Liga de Oro"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "Ligas y rangos"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Para pasar a la siguiente liga, tienes que obtener el rango 1 y clasificarte."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Para ascender de rango, tienes que ganar estrellas."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_HEADER"
msgstr "Estrellas"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Por cada victoria obtienes una estrella. Por cada derrota o empate pierdes una estrella."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_TEXT_2"
msgstr "No perderás la estrella si, al final de la batalla, quedas en 1.er lugar de tu equipo por XP ganada."

msgid "IDS_MODAL_WINDOW_RARE_CREW_MANUAL_HEADER"
msgstr "Entrega de un manual de comandante insólito"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_HEADER"
msgstr "Batalla de clasificación"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "DETALLES DE LA BATALLA"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Te enfrentarás a otros jugadores que son seleccionados según su clasificación de rendimiento en batalla."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "La clasificación se ajusta tras cada batalla en función de su resultado y la XP base obtenida."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Ligas y clasificación"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "El progreso en las Batallas de puntuación se reinicia cada temporada. Al inicio de la temporada, debes disputar 5 batallas para obtener una clasificación en una de las ligas."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "La clasificación máxima en las ligas de Hierro, Bronce, Plata y Oro es 100. Si superas este valor en tu liga actual, ascenderás a la siguiente. En la liga de Obsidiana, puedes aumentar tu clasificación sin límite."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "Divisiones"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "La clasificación de la división es la clasificación media de todos los miembros con un coeficiente creciente según su número. Cuantos más miembros haya en la división, mayor será el coeficiente."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Al emparejar rivales, se tienen en cuenta tanto la clasificación de los jugadores como la clasificación de las divisiones."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_HEADER"
msgstr "Condiciones para participar"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_TEXT_1"
msgstr "La composición de los equipos puede variar según la temporada."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Puedes entrar en batalla en solitario o en una división. El tamaño de la división solo está limitado por el tamaño del equipo."

msgid "IDS_MODAL_WINDOW_RULES_ACHIEVEMENT_HEADER"
msgstr "Logros"

msgid "IDS_MODAL_WINDOW_SEASON_RESTRICTIONS_TITLE"
msgstr "Restricciones a los barcos específicos"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_ALL_ROLES"
msgstr "Ver todos los roles"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TAB_BAR_MAIN"
msgstr "Principales"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TAB_BAR_OTHER"
msgstr "En detalle"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TITLE"
msgstr "Particularidades de los barcos"

msgid "IDS_MODAL_WINDOW_SHIP_BRANCH_FEATURES_TITLE"
msgstr "Particularidades del barco"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_HEADER"
msgstr "Maestría"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_HEADER"
msgstr "Nivel de maestría"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_1"
msgstr "El dominio refleja tu nivel de pericia con un barco concreto y tu experiencia de combate con él. El nivel de maestría se muestra junto al nombre del barco."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Disponible solo para barcos de niveles V–X y superbarcos."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_HEADER"
msgstr "Progreso"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Para pasar al siguiente nivel de maestría, necesitas acumular una cantidad determinada de XP base."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Cuanto mayor sea el nivel del barco y tu nivel de maestría en él, más XP base necesitarás ganar para pasar al siguiente nivel de maestría."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_HEADER"
msgstr "Pruebas"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Para pasar a cada 10.o nivel de maestría, tendrás que superar las pruebas que se seleccionan para cada barco en función de su rol táctico."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_2"
msgstr "En cualquier momento puedes reiniciar las pruebas y obtener otras nuevas."

msgid "IDS_MODAL_WINDOW_SHIP_PURCHASE_SHIP_PRICE"
msgstr "Coste del barco"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_HEADER"
msgstr "Condiciones de obtención"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_HEADER"
msgstr "Cómo conseguir las recompensas"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Cada barco soviético de tu Puerto, desde el nivel III hasta los superbarcos, tiene una recompensa festiva. Para hacerse con ella, tienes que salir a la batalla con ese barco y ganar 300 pts. de XP base o lograr una victoria."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Las recompensas no recogidas se eliminarán al terminar el evento, sin compensación."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_HEADER"
msgstr "Más recompensas por batalla"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Al conseguir más XP base por batalla en un barco con recompensa, podrás recoger recompensas de otros barcos sin necesidad de llevarlos a la batalla."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Cuantos más barcos tengas en tu puerto, mayor será el número máximo de recompensas que puedas recoger tras una batalla."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_3"
msgstr ""
"• 100 barcos: +1 recompensa por 350 puntos de XP;\n"
"• 200 barcos: +2 recompensas por 400 puntos de XP;\n"
"• 300 barcos: +3 recompensas por 450 puntos de XP."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_3_HEADER"
msgstr "Cantidad de recompensas"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_BUTTON"
msgstr "Ir al entrenamiento"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_HEADER"
msgstr "Defensa del Ártico"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_PARAGRAPH_1_HEADER"
msgstr "Sumérgete en la historia"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Tendrás que participar en las batallas de la Flota del Norte durante la Gran Guerra Patria."

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_PARAGRAPH_2_HEADER"
msgstr "Realiza operaciones"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Para completar la operación, debes ganar puntos de progreso realizando tareas. Todas las operaciones se dividen en tres etapas."

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_PARAGRAPH_3_HEADER"
msgstr "Consigue recompensas"

msgid "IDS_MODAL_WINDOW_STRATEGIC_ACTIONS_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Las recompensas se otorgan por cada operación completada. ¡Si completas todas las operaciones, recibirás una recompensa final!"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_1_PARAGRAPH_1_HEADER"
msgstr "Submarinos"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_1_PARAGRAPH_1_TEXT_1"
msgstr "Cuando un submarino emite un impulso de sonar, se ven ondas en la superficie del agua. Estas indican la dirección del movimiento del submarino."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_2_PARAGRAPH_2_HEADER"
msgstr "HIDRÓFONO"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_2_PARAGRAPH_2_TEXT_1"
msgstr "El submarino ve las posiciones de los buques de superficie desde un alcance determinado."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_3_PARAGRAPH_3_HEADER"
msgstr "CARGAS DE PROFUNDIDAD"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_3_PARAGRAPH_3_TEXT_1"
msgstr "Permanecen en el agua durante un tiempo determinado. Infligen daño a los submarinos y destruyen torpedos y minas. Infligen daño insignificante a objetivos de superficie."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_1_PARAGRAPH_1_HEADER"
msgstr "GUIADO DE TORPEDOS"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_1_PARAGRAPH_1_TEXT_1"
msgstr "Antes de lanzar cada torpedo, debes marcar el objetivo con el sonar. La cantidad máxima de tus torpedos que pueden dirigirse al objetivo depende de su clase."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_2_PARAGRAPH_2_HEADER"
msgstr "PROFUNDIDAD MÁXIMA"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_2_PARAGRAPH_2_TEXT_1"
msgstr "A profundidad máxima, el submarino es casi inalcanzable para el enemigo, pero tampoco puede detectar barcos ni usar equipamiento."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_3_PARAGRAPH_3_HEADER"
msgstr "CARGAS DE PROFUNDIDAD"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_3_PARAGRAPH_3_TEXT_1"
msgstr "Se mantienen en el agua durante un tiempo determinado. Infligen daño a los submarinos, destruyen torpedos y minas. Infligen daño insignificante a objetivos de superficie."

msgid "IDS_MODAL_WINDOW_TITLE_CAMOUFLAGE_PURCHASE"
msgstr "Comprar camuflaje"

msgid "IDS_MODAL_WINDOW_TITLE_ECOBOOST_PURCHASE"
msgstr "Comprar bonificación económica"

msgid "IDS_MODAL_WINDOW_TITLE_ECONOMIC_BOOSTS"
msgstr "Bonificaciones económicas"

msgid "IDS_MODAL_WINDOW_TITLE_EPIC_SKILL_DENY"
